# Public site configuration
NEXT_PUBLIC_SITE_URL=https://ladoorganics.in
NEXT_PUBLIC_WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER
NEXT_PUBLIC_UPI_ID=YOUR_UPI_ID
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only secrets — set in Vercel Environment Variables, never in browser code
DATABASE_URL=YOUR_SUPABASE_TRANSACTION_POOLER_URL
# Supabase PostgreSQL root CA PEM (multiline certificate); required for production DB TLS.
SUPABASE_CA_CERT=
# Optional dedicated HMAC secret for rate-limit IP hashing. If omitted,
# the server-only DATABASE_URL is used as the HMAC key.
RATE_LIMIT_SECRET=
# Optional owner break-glass credential. Staff access is controlled by
# Supabase Auth + active staff_accounts records; do not use this for rate limiting.
ADMIN_ACCESS_TOKEN=
ADMIN_NOTIFICATION_EMAIL=YOUR_ADMIN_EMAIL
BHUNGA_NIGHTLY_RATE_INR=4000
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Notification outbox worker. Generate a random secret of at least 32 characters.
# Configure a scheduler to POST /api/internal/notifications/process with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional payment provider configuration. Razorpay is not required for the
# currently enabled Cash on Delivery and manual UPI checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
